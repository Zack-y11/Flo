{
  "name": "flo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "npm run test:domain && npm run test:server && npm run test:ui",
    "test:domain": "node --test src/domain/calendar.test.ts src/domain/field.test.ts",
    "test:server": "node --import tsx --test --test-concurrency=1 src/server/nasa.test.ts src/state/store.test.ts",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
